# Test image for ansible-role-mailclient: openSUSE Leap 16.1 with ansible (incl. community.general: zypper) and the packages the role installs
# (preinstalled, so the role's package task finds them), plus shadow for the fake test users
FROM registry.opensuse.org/opensuse/leap:16.1
RUN zypper -n in --no-recommends ansible evolution MozillaThunderbird glib2-tools dbus-1-daemon dconf gsettings-backend-dconf secret-tool util-linux \
      shadow findutils procps \
 && zypper clean -a
